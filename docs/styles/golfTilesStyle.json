{
    "version": 8,
    "name": "golfTiles",
    "sources": {
        "golfTiles_pmtiles_source": {
            "type": "vector",
            "url": "pmtiles://https://huggek.github.io/golfTiles/samples/golfTiles_se_dk_fi.pmtiles",
            "attribution": "© <a href='https://openstreetmap.org/copyright'>OpenStreetMap</a>. Schema and style <a href='https://github.com/HuggeK/golfTiles'>golfTiles</a>"
        }
    },
    "layers": [
        {
            "id": "facility_border",
            "source": "golfTiles_pmtiles_source",
            "source-layer": "facilities",
            "type": "line",
            "paint": {
                "line-color": "#223631",
                "line-width": 2,
                "line-opacity": 0.8
            }
        },
        {
            "id": "facility_text",
            "source": "golfTiles_pmtiles_source",
            "source-layer": "facilities",
            "type": "symbol",
            "layout": {
                "text-field": "{name}",
                "text-font": ["Open Sans Regular"],
                "text-size": 14,
                "text-variable-anchor": ["center", "top", "bottom", "left", "right"]
            },
            "paint": {
                "text-color": "#FFFFFF"
            }
        },
        {
            "id": "rough",
            "source": "golfTiles_pmtiles_source",
            "source-layer": "golf_polygons",
            "type": "fill",
            "filter": [
                "all",
                ["==", ["get", "golf"], "rough"]
            ],
            "paint": {
                "fill-color": "6f7d56"
            }
        },
        
        
        {
            "id": "golf-points",
            "source": "golfTiles_pmtiles_source",
            "source-layer": "golf_points",
            "type": "line",
            "paint": {
                "line-color": "black"
            }
        },
        {
            "id": "other",
            "source": "golfTiles_pmtiles_source",
            "source-layer": "other",
            "type": "fill",
            "paint": {
                "fill-color": "white"
            }
        }
    ]
}